+            print(f"[Warnung] VST-Pfad muss ein String oder None sein, erhalten: {type(vst_pfad)}. Nutze Standard-Synthese.")
+            vst_pfad = None
+        elif not os.path.exists(vst_pfad):
+            print(f"[Warnung] VST-Pfad '{vst_pfad}' existiert nicht. Nutze Standard-Synthese.")
+            vst_pfad = None
+        else:
+            plugin = _lade_vst(vst_pfad)
+            if plugin is None:
+                print(f"[Warnung] VST-Plugin '{vst_pfad}' konnte nicht geladen werden. Nutze Standard-Synthese.")
+
     # 1. Mapping von instrument_type auf General-MIDI-Programme (0-127)
