@@ -172,6 +173,19 @@
             
-            # 4. Pitch-Shift (Vocoding: Sprechstimme exakt auf den MIDI-Ton zwingen)
-            target_hz = 440.0 * (2.0 ** ((pitch - 69.0) / 12.0))
-            # Behalte die F0>0 Maske bei, damit stimmlose Laute (wie "S", "K") nicht gepitcht werden!
-            f0_vocoded = np.where(f0_stretched > 0, target_hz, 0.0).astype(np.float64)
+            # 4. Pitch-Shift (Vocoding: Sprechstimme exakt auf den MIDI-Ton zwingen)
+            target_hz = 440.0 * (2.0 ** ((pitch - 69.0) / 12.0))
+            
+            # Base F0: force voiced parts to target_hz
+            f0_vocoded = np.where(f0_stretched > 0, target_hz, 0.0).astype(np.float64)
+            
+            # Smooth legato pitch transition if there was a previous active pitch
+            if last_pitch is not None and last_pitch != pitch:
+                last_hz = 440.0 * (2.0 ** ((last_pitch - 69.0) / 12.0))
+                # Glide over 16 frames (approx 80ms) or half the duration
+                glide_frames = min(16, len(f0_vocoded) // 2)
+                if glide_frames > 0:
+                    active_indices = np.where(f0_vocoded > 0)[0]
+                    if len(active_indices) > 0:
+                        glide_indices = active_indices[:glide_frames]
+                        glide_hz = np.linspace(last_hz, target_hz, len(glide_indices))
+                        f0_vocoded[glide_indices] = glide_hz
+            
+            last_pitch = pitch
